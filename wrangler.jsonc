{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "play",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "TABLE", "class_name": "Table" }, { "name": "LEADERBOARD", "class_name": "Leaderboard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Table"] }, { "tag": "v2", "new_sqlite_classes": ["Leaderboard"] }],
  "routes": [{ "pattern": "play.foxesvx.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
